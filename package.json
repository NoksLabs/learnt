{
  "name": "learnt",
  "version": "0.1.0",
  "private": true,
  "description": "Learning-first development for pi, omp, opencode, Codex and Claude Code.",
  "author": "NoksLabs LTD <max@nokslabs.com>",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi/learnt.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./adapters/pi/learnt.js"
    ]
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "effect": "4.0.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:pi && bun run build:opencode",
    "build:cli": "bun build src/cli.ts --target=node --format=esm --outfile=skills/learnt/scripts/learnt.mjs",
    "build:pi": "bun build src/pi.ts --target=node --format=esm --outfile=adapters/pi/learnt.js",
    "build:opencode": "bun build src/opencode.ts --target=node --format=esm --outfile=adapters/opencode/learnt.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run build && git diff --exit-code -- skills/learnt/scripts adapters/pi adapters/opencode/learnt.js && bun test"
  }
}
